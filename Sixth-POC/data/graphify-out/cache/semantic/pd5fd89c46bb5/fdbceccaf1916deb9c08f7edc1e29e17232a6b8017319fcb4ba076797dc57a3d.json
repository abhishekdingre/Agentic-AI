{"nodes": [{"id": "ir_006", "label": "Internal Cardiac Safety Review: hERG and QTc Assessment for AXN-2401", "file_type": "document", "source_file": "corpus/internal_reports/IR-006.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "domain": "internal_reports", "version": "1.0", "status": "current", "original_source_id": "IR-006", "rationale": null}, {"id": "herg_cardiac_safety_signal", "label": "hERG Cardiac Safety Signal (contested)", "file_type": "concept", "source_file": "corpus/internal_reports/IR-006.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "domain": null, "version": null, "status": null, "original_source_id": null, "rationale": "Contested finding: external academic study (LIT-007) reports hERG IC50 = 4.8 micromolar with a free-drug safety margin narrower than the 30-fold reassurance threshold; internal GLP hERG assay (IR-006) reports IC50 > 30 micromolar with a margin exceeding 30-fold, and the dedicated Phase 2 Holter/QTc substudy (CT-004) shows no clinical QTc signal at therapeutic doses. The in vitro numeric discrepancy between LIT-007 and IR-006 is explicitly acknowledged as unresolved by both IR-006 and CT-004 rather than dismissed or explained."}], "edges": [{"source": "lit_007", "target": "ir_006", "relation": "contradicts", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "corpus/internal_reports/IR-006.md", "source_location": null, "weight": 1.0}, {"source": "ir_006", "target": "lit_007", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "corpus/internal_reports/IR-006.md", "source_location": null, "weight": 1.0}, {"source": "ir_006", "target": "herg_cardiac_safety_signal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "corpus/internal_reports/IR-006.md", "source_location": null, "weight": 1.0}, {"source": "ir_006", "targe